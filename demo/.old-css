/* Fullscreen Cosmic Background */
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  width: 100%;
  overflow: hidden;
  font-family: "Poppins", sans-serif;
  color: #fff;
}

#universe-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1; /* stays behind content */
  display: block;
  background: black; /* space */
}

/* Content */
.content {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 3rem 1rem;
}

h1 {
  font-size: 2.5rem;
  text-shadow: 0 0 15px rgba(0,0,0,0.8);
}

p {
  font-size: 1.2rem;
  opacity: 0.9;
}

/* Hover Cards (like suns) */
.hover-zone {
  margin: 2rem auto;
  padding: 2rem;
  width: 60%;
  border-radius: 16px;
  background: radial-gradient(circle at center, rgba(255,200,0,0.25), rgba(30,30,30,0.9));
  backdrop-filter: blur(6px);
  border: 1px solid rgba(255,255,100,0.2);
  transition: 0.3s;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.hover-zone:hover {
  border-color: #ffdf5a;
  box-shadow: 0 0 40px rgba(255,200,50,0.8);
  transform: scale(1.03);
}

.hover-zone h2 {
  color: #ffd369;
  margin-bottom: 0.5rem;
}

.hover-zone p {
  color: #eee;
  opacity: 0.9;
}

/* Explosion particles */
.explosion {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  animation: explode 0.8s forwards;
}

@keyframes explode {
  from { transform: scale(1); opacity: 1; }
  to { transform: scale(3); opacity: 0; }
}
